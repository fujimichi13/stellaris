#version 430 compatibility

layout(triangles) in;
layout(triangle_strip, max_vertices = 48) out;

in vec4 glcolor[];
in vec2 texcoord[];

out vec4 glcolor1;
out vec2 texcoord1;

uniform sampler2D samplerWarpX;
uniform sampler2D samplerWarpY;

float rtwsmWarp1D(sampler2D tex, float u){
    if(u<=0.||u>=1.) return u;
    float t=u*float(256);
    int i=min(int(t),256-1);
    float f=t-float(i);
    float hi=texelFetch(tex,ivec2(i,0),0).r;
    if(hi<=0.) return u;
    float lo=(i==0)?0.:texelFetch(tex,ivec2(i-1,0),0).r;
    return mix(lo,hi,f);
}

vec2 rtwsmWarp(vec2 clipXY){
    vec2 uv=clipXY*.5+.5;
    vec2 w=vec2(rtwsmWarp1D(samplerWarpX,uv.x), rtwsmWarp1D(samplerWarpY,uv.y));
    return w*2.-1.;
}

void main() {
    vec4 p0=gl_in[0].gl_Position;
    vec4 p1=gl_in[1].gl_Position;
    vec4 p2=gl_in[2].gl_Position;
    vec4 c0=glcolor[0];
    vec4 c1=glcolor[1];
    vec4 c2=glcolor[2];
    vec2 t0=texcoord[0];
    vec2 t1=texcoord[1];
    vec2 t2=texcoord[2];

    vec4 p01=mix(p0,p1,.5);
    vec4 p12=mix(p1,p2,.5);
    vec4 p20=mix(p2,p0,.5);
    vec4 c01=mix(c0,c1,.5);
    vec4 c12=mix(c1,c2,.5);
    vec4 c20=mix(c2,c0,.5);
    vec2 t01=mix(t0,t1,.5);
    vec2 t12=mix(t1,t2,.5);
    vec2 t20=mix(t2,t0,.5);

    vec4 pA01=mix(p0,p01,.5);
    vec4 pA12=mix(p01,p20,.5);
    vec4 pA20=mix(p20,p0,.5);
    vec4 cA01=mix(c0,c01,.5);
    vec4 cA12=mix(c01,c20,.5);
    vec4 cA20=mix(c20,c0,.5);
    vec2 tA01=mix(t0,t01,.5);
    vec2 tA12=mix(t01,t20,.5);
    vec2 tA20=mix(t20,t0,.5);

    vec4 pB01=mix(p01,p1,.5);
    vec4 pB12=mix(p1,p12,.5);
    vec4 pB20=mix(p12,p01,.5);
    vec4 cB01=mix(c01,c1,.5);
    vec4 cB12=mix(c1,c12,.5);
    vec4 cB20=mix(c12,c01,.5);
    vec2 tB01=mix(t01,t1,.5);
    vec2 tB12=mix(t1,t12,.5);
    vec2 tB20=mix(t12,t01,.5);

    vec4 pC01=mix(p20,p12,.5);
    vec4 pC12=mix(p12,p2,.5);
    vec4 pC20=mix(p2,p20,.5);
    vec4 cC01=mix(c20,c12,.5);
    vec4 cC12=mix(c12,c2,.5);
    vec4 cC20=mix(c2,c20,.5);
    vec2 tC01=mix(t20,t12,.5);
    vec2 tC12=mix(t12,t2,.5);
    vec2 tC20=mix(t2,t20,.5);

    vec4 pD01=mix(p01,p12,.5);
    vec4 pD12=mix(p12,p20,.5);
    vec4 pD20=mix(p20,p01,.5);
    vec4 cD01=mix(c01,c12,.5);
    vec4 cD12=mix(c12,c20,.5);
    vec4 cD20=mix(c20,c01,.5);
    vec2 tD01=mix(t01,t12,.5);
    vec2 tD12=mix(t12,t20,.5);
    vec2 tD20=mix(t20,t01,.5);

        gl_Position=vec4(rtwsmWarp(p0.xy),p0.z,p0.w);
            glcolor1=c0;
            texcoord1=t0;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pA01.xy),pA01.z,pA01.w);
            glcolor1=cA01;
            texcoord1=tA01;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pA20.xy),pA20.z,pA20.w);
            glcolor1=cA20;
            texcoord1=tA20;
        EmitVertex();
    EndPrimitive();
        gl_Position=vec4(rtwsmWarp(pA01.xy),pA01.z,pA01.w);
            glcolor1=cA01;
            texcoord1=tA01;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(p01.xy),p01.z,p01.w);
            glcolor1=c01;
            texcoord1=t01;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pA12.xy),pA12.z,pA12.w);
            glcolor1=cA12;
            texcoord1=tA12;
        EmitVertex();
    EndPrimitive();
        gl_Position=vec4(rtwsmWarp(pA20.xy),pA20.z,pA20.w);
            glcolor1=cA20;
            texcoord1=tA20;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pA12.xy),pA12.z,pA12.w);
            glcolor1=cA12;
            texcoord1=tA12;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(p20.xy),p20.z,p20.w);
            glcolor1=c20;
            texcoord1=t20;
        EmitVertex();
    EndPrimitive();
        gl_Position=vec4(rtwsmWarp(pA01.xy),pA01.z,pA01.w);
            glcolor1=cA01;
            texcoord1=tA01;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pA12.xy),pA12.z,pA12.w);
            glcolor1=cA12;
            texcoord1=tA12;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pA20.xy),pA20.z,pA20.w);
            glcolor1=cA20;
            texcoord1=tA20;
        EmitVertex();
    EndPrimitive();
        gl_Position=vec4(rtwsmWarp(p01.xy),p01.z,p01.w);
            glcolor1=c01;
            texcoord1=t01;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pB01.xy),pB01.z,pB01.w);
            glcolor1=cB01;
            texcoord1=tB01;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pB20.xy),pB20.z,pB20.w);
            glcolor1=cB20;
            texcoord1=tB20;
        EmitVertex();
    EndPrimitive();
        gl_Position=vec4(rtwsmWarp(pB01.xy),pB01.z,pB01.w);
            glcolor1=cB01;
            texcoord1=tB01;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(p1.xy),p1.z,p1.w);
            glcolor1=c1;
            texcoord1=t1;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pB12.xy),pB12.z,pB12.w);
            glcolor1=cB12;
            texcoord1=tB12;
        EmitVertex();
    EndPrimitive();
        gl_Position=vec4(rtwsmWarp(pB20.xy),pB20.z,pB20.w);
            glcolor1=cB20;
            texcoord1=tB20;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pB12.xy),pB12.z,pB12.w);
            glcolor1=cB12;
            texcoord1=tB12;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(p12.xy),p12.z,p12.w);
            glcolor1=c12;
            texcoord1=t12;
        EmitVertex();
    EndPrimitive();
        gl_Position=vec4(rtwsmWarp(pB01.xy),pB01.z,pB01.w);
            glcolor1=cB01;
            texcoord1=tB01;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pB12.xy),pB12.z,pB12.w);
            glcolor1=cB12;
            texcoord1=tB12;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pB20.xy),pB20.z,pB20.w);
            glcolor1=cB20;
            texcoord1=tB20;
        EmitVertex();
    EndPrimitive();
        gl_Position=vec4(rtwsmWarp(p20.xy),p20.z,p20.w);
            glcolor1=c20;
            texcoord1=t20;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pC01.xy),pC01.z,pC01.w);
            glcolor1=cC01;
            texcoord1=tC01;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pC20.xy),pC20.z,pC20.w);
            glcolor1=cC20;
            texcoord1=tC20;
        EmitVertex();
    EndPrimitive();
        gl_Position=vec4(rtwsmWarp(pC01.xy),pC01.z,pC01.w);
            glcolor1=cC01;
            texcoord1=tC01;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(p12.xy),p12.z,p12.w);
            glcolor1=c12;
            texcoord1=t12;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pC12.xy),pC12.z,pC12.w);
            glcolor1=cC12;
            texcoord1=tC12;
        EmitVertex();
    EndPrimitive();
        gl_Position=vec4(rtwsmWarp(pC20.xy),pC20.z,pC20.w);
            glcolor1=cC20;
            texcoord1=tC20;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pC12.xy),pC12.z,pC12.w);
            glcolor1=cC12;
            texcoord1=tC12;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(p2.xy),p2.z,p2.w);
            glcolor1=c2;
            texcoord1=t2;
        EmitVertex();
    EndPrimitive();
        gl_Position=vec4(rtwsmWarp(pC01.xy),pC01.z,pC01.w);
            glcolor1=cC01;
            texcoord1=tC01;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pC12.xy),pC12.z,pC12.w);
            glcolor1=cC12;
            texcoord1=tC12;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pC20.xy),pC20.z,pC20.w);
            glcolor1=cC20;
            texcoord1=tC20;
        EmitVertex();
    EndPrimitive();
        gl_Position=vec4(rtwsmWarp(p01.xy),p01.z,p01.w);
            glcolor1=c01;
            texcoord1=t01;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pD01.xy),pD01.z,pD01.w);
            glcolor1=cD01;
            texcoord1=tD01;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pD20.xy),pD20.z,pD20.w);
            glcolor1=cD20;
            texcoord1=tD20;
        EmitVertex();
    EndPrimitive();
        gl_Position=vec4(rtwsmWarp(pD01.xy),pD01.z,pD01.w);
            glcolor1=cD01;
            texcoord1=tD01;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(p12.xy),p12.z,p12.w);
            glcolor1=c12;
            texcoord1=t12;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pD12.xy),pD12.z,pD12.w);
            glcolor1=cD12;
            texcoord1=tD12;
        EmitVertex();
    EndPrimitive();
        gl_Position=vec4(rtwsmWarp(pD20.xy),pD20.z,pD20.w);
            glcolor1=cD20;
            texcoord1=tD20;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pD12.xy),pD12.z,pD12.w);
            glcolor1=cD12;
            texcoord1=tD12;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(p20.xy),p20.z,p20.w);
            glcolor1=c20;
            texcoord1=t20;
        EmitVertex();
    EndPrimitive();
        gl_Position=vec4(rtwsmWarp(pD01.xy),pD01.z,pD01.w);
            glcolor1=cD01;
            texcoord1=tD01;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pD12.xy),pD12.z,pD12.w);
            glcolor1=cD12;
            texcoord1=tD12;
        EmitVertex();
        gl_Position=vec4(rtwsmWarp(pD20.xy),pD20.z,pD20.w);
            glcolor1=cD20;
            texcoord1=tD20;
        EmitVertex();
    EndPrimitive();
}